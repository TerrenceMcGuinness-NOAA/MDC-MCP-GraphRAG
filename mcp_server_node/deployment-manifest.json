      "vitest.setup.js"
    ],
    "utilities": [
      "run-documentation-ingestion.js"
    ],
    "healthChecks": [
      "test-data-access.js",
      "test-neo4j-connection.js",
      "test-chromadb-3x.js",
      "test-rag-quick.js",
      "validate-ee2-search.js"
    ]
  },
  "legacyFiles": {
    "toArchive": [
      "embedding-optimizer.js",
      "optimized-rag-server.js",
      "optimized-vector-store.js",
      "test-enhanced-rag-system.js",
      "test_mcp_tool.js",
      "test-optimization.js",
