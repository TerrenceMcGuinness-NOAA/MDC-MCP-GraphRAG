    "archiveDate": "2025-10-16",
    "reason": "Pre-AWS prototype artifacts, superseded by Week 1 refactor"
  },
  "excludePatterns": [
    "node_modules/",
    "*.test.js",
    "__tests__/",
    ".git/",
    "*.log",
    ".DS_Store",
    "*.swp",
    "*~"
  ],
  "deploymentSteps": [
    "1. Archive legacy files to contrib/",
    "2. Backup current runtime",
    "3. Sync production files from repository",
    "4. Run npm install",
    "5. Verify health checks",
    "6. Update deployment log"
  ],
  "healthCheckCommands": [
    "node test-data-access.js",
    "node test-neo4j-connection.js",
    "node test-chromadb-3x.js"
  ],
  "rollbackManifest": "deployment-manifest-v1.0.0.json",
  "dependencies": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "services": [
      "chromadb-persistent.service",
      "docker (neo4j container)",
      "docker (langflow container)"
    ]
  },
  "postDeployment": {
    "verifyServices": [
      "systemctl status chromadb-persistent.service",
      "docker ps | grep neo4j",
      "docker ps | grep langflow"
    ],
    "testConnections": [
      "curl -f http://localhost:8080/api/v1/heartbeat",
      "curl -f http://localhost:7474",
      "curl -f http://localhost:7860"
    ]
  }
}
