{
  "name": "global-workflow-rag-mcp-server",
  "version": "1.0.0",
  "description": "RAG-enhanced MCP server for Global Workflow system with vector database integration",
  "main": "mcp-server-rag.js",
  "scripts": {
    "start": "node mcp-server-rag.js",
    "start-basic": "node mcp-server.js",
    "ingest": "node document-ingester.js",
    "setup-rag": "npm run ingest && npm run create-embeddings",
    "create-embeddings": "node scripts/create-embeddings.js",
    "test": "node test/test-rag-server.js",
    "dev": "nodemon mcp-server-rag.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rag",
    "retrieval-augmented-generation",
    "global-workflow",
    "weather-prediction",
    "copilot"
  ],
  "author": "Global Workflow Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "chromadb": "^1.8.1",
    "openai": "^4.28.0",
    "@xenova/transformers": "^2.15.0",
    "langchain": "^0.1.25",
    "mammoth": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "cheerio": "^1.0.0-rc.12",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "js-yaml": "^4.1.0",
    "dotenv": "^16.4.5",
    "winston": "^3.11.0",
    "node-fetch": "^3.3.2",
    "cohere-ai": "^7.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "jest": "^29.7.0",
    "@types/node": "^20.11.17"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TerrenceMcGuinness-NOAA/global-workflow.git"
  },
  "config": {
    "vector_db": "chromadb",
    "embedding_model": "openai",
    "chunk_size": 1000,
    "chunk_overlap": 200,
    "similarity_threshold": 0.7
  }
}
