# Dockerfile.sagemaker — ECR container for SageMaker Processing Jobs
# Supports both CPU and GPU instances via build argument

ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /opt/ml/processing

# Copy requirements and install Python dependencies
COPY requirements-sagemaker.txt .
RUN pip install --no-cache-dir -r requirements-sagemaker.txt

# Copy ingestion scripts and modules
COPY scripts/embedding_registry.py input/
COPY scripts/embedding_provider.py input/
COPY scripts/collection_namer.py input/
COPY scripts/ingestion_base.py input/
COPY scripts/aws_backend.py input/
COPY scripts/ingest_*.py input/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV CACHE_ROOT=/opt/ml/processing/cache
ENV AWS_REGION=us-east-1

# Create cache directory
RUN mkdir -p /opt/ml/processing/cache

# Default entrypoint (overridden by SageMaker job spec)
ENTRYPOINT ["python3"]
