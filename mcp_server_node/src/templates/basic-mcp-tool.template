export class {{className}} {
  constructor(options = {}) {
    this.name = '{{className}}';
    this.version = '1.0.0';
    this.options = options;
  }

  /**
   * Register tools with MCP server
   * @param {Object} server - MCP server instance
   */
  registerWith(server) {
    server.tool(
      '{{toolName}}',
      '{{toolDescription}}',
      {
        type: 'object',
        properties: {
          input: {
            type: 'string',
            description: 'Input for the tool'
          }
        }
      },
      async (args) => {
        return await this.execute(args);
      }
    );

    console.error('[MCP] {{className}} registered: {{toolName}}');
  }

  /**
   * Execute the tool operation
   * @param {Object} args - Tool arguments
   * @returns {Object} MCP response
   */
  async execute(args) {
    try {
      const result = await this.performOperation(args);
      
      return {
        content: [{
          type: 'text',
          text: JSON.stringify(result, null, 2)
        }]
      };
    } catch (error) {
      return {
        content: [{
          type: 'text',
          text: `Error: ${error.message}`
        }],
        isError: true
      };
    }
  }

  /**
   * Core operation logic - override in generated tools
   * @param {Object} args - Input arguments
   * @returns {Object} Operation result
   */
  async performOperation(args) {
    return {
      status: 'success',
      message: `{{className}} executed`,
      input: args.input || 'No input provided',
      timestamp: new Date().toISOString()
    };
  }
}
