# Global Workflow MCP Server Configuration
#
# This file controls the behavior of the MCP server startup script.
# You can either set environment variables or modify this file.
#
# Updated: 2025-10-09 for Parallel Works production deployment

# ============================================================================
# PERSISTENT STORAGE PATHS (Updated for /contrib/Terry.McGuinness/opt/)
# ============================================================================

# MCP Server Root Directory (Persistent Storage)
MCP_ROOT=/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node

# Knowledge Base Directory
MCP_KNOWLEDGE_BASE=/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node/knowledge-base

# Global Workflow Root (Source Repository for Analysis)
MCP_WORKFLOW_ROOT=/mcp_rag_eib/global-workflow_forked

# ChromaDB Persistent Storage
CHROMA_ROOT=/contrib/Terry.McGuinness/opt/chromadb-data
CHROMA_PERSIST_DIRECTORY=/contrib/Terry.McGuinness/opt/chromadb-data

# Transformer Model Cache
TRANSFORMERS_CACHE=/contrib/Terry.McGuinness/opt/mcp-server/cache

# Node.js Cache Directory
NPM_CONFIG_CACHE=/contrib/Terry.McGuinness/opt/mcp-server/cache/npm

# ============================================================================
# CHROMADB CONFIGURATION
# ============================================================================

# ChromaDB Server Settings
CHROMA_HOST=localhost
CHROMA_PORT=8080

# ChromaDB Client Mode: 'server' or 'embedded'
# Use 'embedded' for in-process ChromaDB (simpler, no separate service needed)
# Use 'server' for dedicated ChromaDB service
CHROMA_CLIENT_MODE=embedded

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Node.js Environment
NODE_ENV=production

# Hugging Face Integration
# Set to 'true' to enable enhanced server with HF capabilities
# Set to 'false' to use standard RAG server only
ENABLE_HF_INTEGRATION=false

# Logging Configuration
# Set to 'true' to suppress informational messages
QUIET_MODE=false

# ============================================================================
# RAG CONFIGURATION
# ============================================================================

# Stability Configuration
# Full RAG server with stability improvements
DISABLE_EMBEDDINGS=false
LIGHTWEIGHT_MODE=false

# Embedding Model
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Vector Search Parameters
MAX_SEARCH_RESULTS=10
SIMILARITY_THRESHOLD=0.1

# ============================================================================
# OPTIONAL CONFIGURATIONS
# ============================================================================

# Node.js Configuration
# Path to centralized node_modules (if using)
COPILOT_NODE_MODULES=/contrib/Terry.McGuinness/opt/mcp-server/node_modules

# GitHub Integration
# Set your GitHub token here or export GITHUB_TOKEN in your environment
GITHUB_TOKEN=${GITHUB_TOKEN:-}
# Note: Token should have 'repo' scope for full functionality

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Enable Performance Monitoring
ENABLE_MONITORING=false
