{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vector_Export record (one JSON object per JSONL line)",
  "type": "object",
  "required": ["id", "content", "embedding", "model_profile", "collection_name"],
  "properties": {
    "id": {"type": "string"},
    "content": {"type": "string"},
    "embedding": {
      "type": "array",
      "items": {"type": "number"},
      "description": "Bitwise-preserved embedding; length equals the model_profile dimension."
    },
    "metadata": {"type": "object"},
    "model_profile": {"type": "string"},
    "collection_name": {"type": "string"},
    "chunk_id": {"type": ["string", "null"]}
  }
}
