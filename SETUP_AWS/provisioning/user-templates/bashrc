# .bashrc — MDC MCP Developer Environment
# Provisioned by provision-user-accounts.sh

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User-local bin (pip install --user, kiro-cli, etc.)
if ! [[ "$PATH" =~ "$HOME/.local/bin" ]]; then
    PATH="$HOME/.local/bin:$PATH"
fi
export PATH

# ── Shared MCP Python environment (Spack-managed venv) ───────────────────────
# Provides boto3, fastmcp, opensearch-py, strands-agents, opentelemetry, etc.
# for all developer accounts without any per-user pip installs.
# Maintained by ec2-user; venv lives at /mnt/mdc-mcp-rag/spack/var/mcp-venv
_MCP_ACTIVATE="/mnt/mdc-mcp-rag/spack/mcp-env-activate.sh"
if [[ -f "${_MCP_ACTIVATE}" ]]; then
    source "${_MCP_ACTIVATE}"
else
    echo "[WARN] MCP Spack env not found: ${_MCP_ACTIVATE}" >&2
    echo "       Contact ec2-user to re-provision the Spack environment." >&2
fi
unset _MCP_ACTIVATE
# ─────────────────────────────────────────────────────────────────────────────

# AWS region default
export AWS_REGION=us-east-1

# Workspace shortcuts
export MCP_WORKSPACE=/mdc-mcp-rag/eib-mcp-rag-server

# Fix TTY variable for Kiro CLI (suppresses "not a tty" errors over SSH)
if [[ -z "${TTY:-}" ]]; then
    TTY=$(tty 2>/dev/null) || TTY="/dev/null"
fi
export TTY

# Git branch in prompt
__git_branch() {
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    [[ -n "$branch" ]] && echo " ($branch)"
}

# Prompt: user@host basename (branch)$
PS1='\u@\h \W$(__git_branch)\$ '

# Aliases
alias ws='cd $MCP_WORKSPACE'
alias work='cd $SCRATCH'
alias mcp-health='python3 -c "import boto3; c=boto3.client(\"bedrock-agentcore\",region_name=\"us-east-1\"); print(\"AWS OK\")"'
alias mcp-env-check='python3 -c "import boto3,fastmcp,opensearchpy; print(\"boto3:\",boto3.__version__,\"| fastmcp:\",fastmcp.__version__,\"| opensearch-py:\",opensearchpy.__version__)"'
