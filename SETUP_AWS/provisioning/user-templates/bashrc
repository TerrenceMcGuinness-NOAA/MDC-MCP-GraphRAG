# .bashrc — MDC MCP Developer Environment
# Provisioned by provision-user-accounts.sh

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User-local bin (pip install --user, kiro-cli, etc.)
if ! [[ "$PATH" =~ "$HOME/.local/bin" ]]; then
    PATH="$HOME/.local/bin:$PATH"
fi
export PATH

# AWS region default
export AWS_REGION=us-east-1

# Workspace shortcuts
export MCP_WORKSPACE=/mdc-mcp-rag/eib-mcp-rag-server

# Fix TTY variable for Kiro CLI (suppresses "not a tty" errors over SSH)
if [[ -z "${TTY:-}" ]]; then
    TTY=$(tty 2>/dev/null) || TTY="/dev/null"
fi
export TTY

# Git branch in prompt
__git_branch() {
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    [[ -n "$branch" ]] && echo " ($branch)"
}

# Prompt: user@host basename (branch)$
PS1='\u@\h \W$(__git_branch)\$ '

# Aliases
alias ws='cd $MCP_WORKSPACE'
alias work='cd $SCRATCH'
alias mcp-health='python3.12 -c "import boto3; c=boto3.client(\"bedrock-agentcore\",region_name=\"us-east-1\"); print(\"AWS OK\")"'
