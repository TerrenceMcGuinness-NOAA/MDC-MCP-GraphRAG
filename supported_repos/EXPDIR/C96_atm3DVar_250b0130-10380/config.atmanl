#! /usr/bin/env bash

########## config.atmanl ##########
# configuration common to all atm var analysis tasks

echo "BEGIN: config.atmanl"

export OBS_LIST_YAML="${PARMglobal}/gdas/atm/atm_obs_list.yaml.j2"
