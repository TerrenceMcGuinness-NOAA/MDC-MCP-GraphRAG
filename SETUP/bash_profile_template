# ========================================================================
# Module System and MCP RAG Environment (Rocky 9 Architecture)
# ========================================================================
# ARCHITECTURE: Use system Lmod + local Spack at /mcp_rag_eib/spack
# NOT using: /apps/spack or /contrib-epic/spack-stack-rocky8 (doesn't exist on Rocky 9)

# Initialize system Lmod FIRST
if [ -f /apps/lmod/lmod/init/bash ]; then
    . /apps/lmod/lmod/init/bash
    
    # Add legacy TCL module path
    module use /apps/modules/modulefiles 2>/dev/null
    
    # Add local Spack Lmod modules
    if [ -d /mcp_rag_eib/spack/share/spack/lmod/linux-rocky9-x86_64/Core ]; then
        module use /mcp_rag_eib/spack/share/spack/lmod/linux-rocky9-x86_64/Core 2>/dev/null
    fi
    
    # Load required modules
    ml rocoto 2>/dev/null || true
    ml contrib 2>/dev/null || true
    ml python/3.11 2>/dev/null || true
elif [ -f /usr/share/Modules/init/bash ]; then
    # Fallback to Environment Modules if system Lmod not available
    . /usr/share/Modules/init/bash
    module use /apps/modules/modulefiles 2>/dev/null
    module load rocoto 2>/dev/null || true
    module load contrib 2>/dev/null || true
    module load python/3.11 2>/dev/null || true
fi

# Source Spack environment (for spack command, but NOT for module system)
if [ -f /mcp_rag_eib/spack/share/spack/setup-env.sh ]; then
    . /mcp_rag_eib/spack/share/spack/setup-env.sh
fi

# Source MCP environment (won't reinitialize modules)
if [ -f /mcp_rag_eib/SETUP/mcp-env.sh ]; then
    source /mcp_rag_eib/SETUP/mcp-env.sh --quiet
fi
