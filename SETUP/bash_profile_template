# ========================================================================
# Module System and MCP RAG Environment (Rocky 9 Architecture)
# ========================================================================
# ARCHITECTURE: Use system Lmod from dnf package + local Spack at /mcp_rag_eib/spack
# Lmod installed via: sudo dnf install Lmod
# NOT using: /apps/lmod (external mount) or /contrib-epic/spack-stack-rocky8

# Spack module paths
SPACK_LMOD_CORE="/mcp_rag_eib/spack/share/spack/lmod/linux-rocky9-x86_64/Core"
SPACK_GCC_MODULES="/mcp_rag_eib/spack/share/spack/lmod/linux-rocky9-x86_64/gcc/11.5.0"
CUSTOM_MODULES="/mcp_rag_eib/etc/modulefiles"
LMOD_RC="/mcp_rag_eib/etc/lmod/lmodrc.lua"

# Initialize Lmod - prefer system Lmod from dnf package
if [ -f /usr/share/lmod/lmod/init/bash ]; then
    # Use system Lmod (installed via dnf install Lmod)
    export LMOD_RC="${LMOD_RC}"
    . /usr/share/lmod/lmod/init/bash
    
    # Add legacy TCL module path (rocoto, contrib, intel modules are here)
    module use /apps/modules/modulefiles &>/dev/null
    
    # Add custom MCP modules
    [ -d "${CUSTOM_MODULES}" ] && module use "${CUSTOM_MODULES}" &>/dev/null
    
    # Only attempt Spack module loading if Spack has been provisioned with gcc
    # This prevents errors on fresh VMs before provisioning completes
    if [ -d "${SPACK_LMOD_CORE}" ] && [ -d "${SPACK_GCC_MODULES}" ]; then
        # Add local Spack Lmod core modules
        module use "${SPACK_LMOD_CORE}" &>/dev/null
        
        # Load gcc FIRST to expose compiler-dependent spack modules (py-* packages)
        # Lmod will automatically add hierarchical paths: .../gcc/11.5.0/
        ml gcc/11.5.0 &>/dev/null || true
        
        # Load Python and essential packages for ChromaDB/MCP
        ml python/3.11 py-pip py-pydantic py-neo4j py-fparser &>/dev/null || true
    fi
    
    # Load legacy TCL modules (rocoto, contrib) - these don't depend on Spack
    ml rocoto &>/dev/null || true
    ml contrib &>/dev/null || true
    
elif [ -f /apps/lmod/lmod/init/bash ]; then
    # Fallback to /apps mount if available (external HPC environment)
    . /apps/lmod/lmod/init/bash
    module use /apps/modules/modulefiles &>/dev/null
    [ -d "${SPACK_LMOD_CORE}" ] && module use "${SPACK_LMOD_CORE}" &>/dev/null
    ml gcc/11.5.0 python/3.11 py-pip py-pydantic py-neo4j py-fparser &>/dev/null || true
    ml rocoto contrib &>/dev/null || true
    
elif [ -f /usr/share/Modules/init/bash ]; then
    # Last resort: Environment Modules (TCL-based, can't use Spack Lmod modules)
    . /usr/share/Modules/init/bash
    module use /apps/modules/modulefiles &>/dev/null
    module load rocoto &>/dev/null || true
    module load contrib &>/dev/null || true
fi

# Source Spack environment (for spack command, but NOT for module system)
if [ -f /mcp_rag_eib/spack/share/spack/setup-env.sh ]; then
    . /mcp_rag_eib/spack/share/spack/setup-env.sh
fi

# Source MCP environment (won't reinitialize modules)
if [ -f /mcp_rag_eib/eib-mcp-rag-server/SETUP/mcp-env.sh ]; then
    source /mcp_rag_eib/eib-mcp-rag-server/SETUP/mcp-env.sh --quiet
fi
