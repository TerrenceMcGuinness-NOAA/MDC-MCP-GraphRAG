# MCP tunnel via Hera - uses REVERSE tunnel from MCP server
# STEP 1: On MCP server (here), run: ssh HeraReverse -N &
#         This makes Hera's localhost:18888 point back to MCP server's 18888
# STEP 2: Again here then use ssh HeraMCP-internal
#         
Host HeraReverse
   User Terry.McGuinness
   HostName hera-rsa.princeton.rdhpcs.noaa.gov
   IdentityFile ~/.ssh/id_rsa
   ServerAliveInterval 60
   ServerAliveCountMax 30
   ExitOnForwardFailure yes
   LocalForward 6472 localhost:6472

# Second: Use port 6472 to reach hfe11 directly, forward 18888 back
Host HeraMCP-internal
   User Terry.McGuinness
   HostName localhost
   Port 6472
   IdentityFile ~/.ssh/id_rsa
   ServerAliveInterval 60
   ServerAliveCountMax 30
   # RemoteForward: hfe11:18888 → MCP:18888
   RemoteForward 18888 localhost:18888
