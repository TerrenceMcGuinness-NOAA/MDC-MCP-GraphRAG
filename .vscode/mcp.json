{
  "servers": {
    // ============================================================================
    // MCP SERVER SELECTION GUIDE (SOC - Separation of Concerns)
    // ============================================================================
    // 
    // SERVER SELECTION BY TASK:
    // ┌─────────────────────────────────────────────────────────────────────────┐
    // │ Task                           │ Use Server           │ Tools Available │
    // ├─────────────────────────────────────────────────────────────────────────┤
    // │ GFS/GEFS code structure        │ global-workflow-core │ 16 (Neo4j)      │
    // │ Weather documentation (RAG)    │ eib-mcp-gateway      │ 35 (full)       │
    // │ EE2 compliance checking        │ eib-mcp-gateway      │ 35 (full)       │
    // │ HPC operational guidance       │ eib-mcp-gateway      │ 35 (full)       │
    // │ GitHub issues/PRs              │ eib-mcp-gateway      │ 35 (full)       │
    // └─────────────────────────────────────────────────────────────────────────┘
    //
    // TWO DOMAINS:
    // 1. Global Workflow (GFS/GEFS) - Weather forecasting code analysis
    // 2. MCP/RAG Infrastructure    - This development platform's health + RAG
    //
    // DB DEPENDENCIES:
    // - global-workflow-core: Neo4j only (fast, code-focused)
    // - eib-mcp-gateway: ChromaDB + Neo4j (full RAG capabilities)
    // ============================================================================

    // FULL MODE: All 49 tools - RAG search, EE2 compliance, GitHub, code analysis
    // Use when: You need documentation search, compliance checking, or operational guidance
    // DB required: ChromaDB (vectors) + Neo4j (graph)
    // NOTE: Direct stdio mode - more stable than gateway (no 5-min timeout bug)
    "eib-mcp-rag-full": {
      "command": "node",
      "args": [
        "/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node/src/UnifiedMCPServer.js",
        "full"
      ],
      "type": "stdio",
      "env": {
        "MCP_WORKSPACE_ROOT": "/mcp_rag_eib/eib-mcp-rag-server",
        "MCP_WORKFLOW_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/supported_repos/global-workflow",
        "SDD_FRAMEWORK_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/sdd_framework",
        "CHROMA_SERVER_URL": "http://localhost:8080",
        "CHROMADB_URL": "http://127.0.0.1:8080",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_PASSWORD": "gfsworkflow2025",
        "ENABLE_RAG": "true",
        "ENABLE_GITHUB": "true"
      }
    },
