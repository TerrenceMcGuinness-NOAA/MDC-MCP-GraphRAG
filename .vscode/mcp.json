{
  "servers": {
    // Local stdio server (original - for direct local use)
    "eib-mcp-rag-full": {
      "command": "node",
      "args": [
        "/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node/src/UnifiedMCPServer.js",
        "full"
      ],
      "type": "stdio",
      "env": {
        "MCP_WORKSPACE_ROOT": "/mcp_rag_eib/eib-mcp-rag-server",
        "MCP_WORKFLOW_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/supported_repos/global-workflow",
        "SDD_FRAMEWORK_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/sdd_framework",
        "CHROMA_SERVER_URL": "http://localhost:8080",
        "CHROMADB_URL": "http://127.0.0.1:8080",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_PASSWORD": "gfsworkflow2025",
        "ENABLE_RAG": "true",
        "ENABLE_GITHUB": "true",
        "GITHUB_TOKEN": "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"
      }
    },
    // Remote gateway via SSH port forward (use after: ssh -L 8888:localhost:8888 remote-host)
    // Start gateway with: sudo systemctl start mcp-gateway
    // Uses fixed token (MCP_GATEWAY_AUTH_TOKEN environment variable)
    // 
    // Uses Streamable HTTP transport (MCP spec 2025-06-18)
    // VS Code 1.102+ supports "type": "http" - tries Streamable HTTP first, falls back to SSE
    // Gateway runs with --transport streaming which exposes /mcp endpoint
    "eib-mcp-gateway": {
      "type": "http",
      "url": "http://localhost:8888/mcp",
      "headers": {
        "Authorization": "Bearer eib-mcp-gateway-token-2025"
      }
    },
    // Direct remote access (replace YOUR_REMOTE_IP with actual IP)
    // DISABLED - uncomment when gateway is running
    // "eib-mcp-gateway-direct": {
    //   "type": "http",
    //   "url": "http://3.238.80.83:8888/mcp",
    //   "headers": {
    //     "Authorization": "Bearer n6zhx980geq5qunerdwoh7xijz0zqog5l6860pjruzp1mqslas"
    //   }
    // },
    "global-workflow-core": {
      "command": "node",
      "args": [
        "/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node/src/UnifiedMCPServer.js",
        "core"
      ],
      "type": "stdio",
      "env": {
        "MCP_WORKFLOW_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/supported_repos/global-workflow"
      }
    }
  }
}
