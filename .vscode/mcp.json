{
  "servers": {
    "eib-mcp-rag-full": {
      "command": "node",
      "args": [
        "/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node/mcp-server-full.js"
      ],
      "type": "stdio",
      "env": {
        "MCP_WORKSPACE_ROOT": "/mcp_rag_eib/eib-mcp-rag-server",
        "MCP_WORKFLOW_ROOT": "/mcp_rag_eib/global-workflow_forked",
        "SDD_FRAMEWORK_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/sdd_framework",
        "CHROMA_SERVER_URL": "http://localhost:8080"
      }
    },
    "eib-mcp-rag-runtime": {
      "command": "node",
      "args": [
        "/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node/src/UnifiedMCPServer.js",
        "rag"
      ],
      "type": "stdio",
      "env": {
        "MCP_WORKSPACE_ROOT": "/mcp_rag_eib/eib-mcp-rag-server",
        "MCP_WORKFLOW_ROOT": "/mcp_rag_eib/global-workflow_forked",
        "SDD_FRAMEWORK_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/sdd_framework",
        "CHROMA_SERVER_URL": "http://localhost:8080"
      }
    },
    "eib-sdd-validator": {
      "command": "node",
      "args": [
        "/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node/mcp-server-sdd.js"
      ],
      "type": "stdio",
      "env": {
        "SDD_FRAMEWORK_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/sdd_framework",
        "MCP_WORKSPACE_ROOT": "/mcp_rag_eib/eib-mcp-rag-server"
      }
    },
    "global-workflow-core": {
      "command": "node",
      "args": [
        "/mcp_rag_eib/eib-mcp-rag-server/mcp_server_node/mcp-server-workflow-core.js"
      ],
      "type": "stdio",
      "env": {
        "MCP_WORKSPACE_ROOT": "/mcp_rag_eib/eib-mcp-rag-server",
        "MCP_WORKFLOW_ROOT": "/mcp_rag_eib/global-workflow_forked",
        "SDD_FRAMEWORK_ROOT": "/mcp_rag_eib/eib-mcp-rag-server/sdd_framework"
      }
    }
  }
}
