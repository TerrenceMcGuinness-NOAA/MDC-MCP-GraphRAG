    // GATEWAY MODE: Docker container with full 35 tools via Streamable HTTP
    // Use when: Remote access, multi-client (LangFlow, Claude Desktop, n8n)
    // Transport: Streamable HTTP (bidirectional - MCP spec 2025-06-18)
    // Start with: sudo systemctl start mcp-gateway
    //         or: docker mcp gateway run --servers eib-mcp-rag --transport streaming --port 18888 --long-lived
    // Port forward: ssh -L 18888:localhost:18888 remote-host
    // Token: Set MCP_GATEWAY_AUTH_TOKEN env var for static token, otherwise dynamic
    // Verify tools: docker mcp tools ls
    "eib-mcp-gateway": {
      "type": "http",
      "url": "https://27gs01wv-18888.use.devtunnels.ms/.use.devtunnels.ms/mcp",
      "headers": {
        "Authorization": "Bearer eib-mcp-gateway-token-2025"
      }
    },

    // CORE MODE: 16 tools - Code analysis only (NO RAG, NO EE2, NO GitHub)
